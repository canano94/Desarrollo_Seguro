# Copiar como .env  ->  NUNCA subir el .env al repositorio (agrégalo al .gitignore)

NODE_ENV=development
PORT=3000

# Usuario de mínimo privilegio creado en el script 01
DATABASE_URL=postgresql://api_agendamiento:CAMBIA_ESTA_CLAVE@localhost:5432/agendamiento_crm

# Generar con:  node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=reemplazar_por_un_secreto_aleatorio_de_al_menos_32_caracteres
JWT_ISSUER=agendamiento-crm
JWT_AUDIENCE=agendamiento-crm-web
ACCESS_TOKEN_TTL=15m

REFRESH_TTL_DAYS=7
REFRESH_COOKIE_NAME=rt

# Origen del frontend (obligatorio para que funcionen las cookies con credentials)
CORS_ORIGIN=http://localhost:5173

# Política de bloqueo por fuerza bruta
MAX_INTENTOS_FALLIDOS=5
BLOQUEO_MINUTOS=15

# Buscador de direcciones del mapa (Nominatim de OpenStreetMap, gratis)
# Correo de contacto que se manda a Nominatim, lo piden en sus reglas de uso
MAPA_CONTACTO=tu_correo@ejemplo.com
# Paises donde se buscan direcciones (co = Colombia). Varios: co,ec,pe
MAPA_PAISES=co

# Recordatorios push. Generar las llaves UNA vez con:
#   npx web-push generate-vapid-keys
# La privada es secreta: va solo en el .env y en Azure, nunca en el chat ni en Git.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tu_correo@ejemplo.com

# Correos con Brevo. Sin BREVO_API_KEY la app funciona en modo prueba (los correos quedan como SIMULADO)
# La llave es secreta: va solo en el .env y en Azure, nunca en el chat ni en Git
BREVO_API_KEY=
# Correo verificado en Brevo (Senders) y nombre por defecto del remitente
CORREO_REMITENTE=tu_correo@ejemplo.com
CORREO_REMITENTE_NOMBRE=Agenda
# Direccion de la app, para el boton "Ver mis turnos" de los correos
APP_URL=http://localhost:3000

# Registro publico de cuentas (/api/auth/registro). Apagado por defecto: las cuentas las crean los administradores
REGISTRO_PUBLICO=false
