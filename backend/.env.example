# Copiar como .env  ->  NUNCA subir el .env al repositorio (agrégalo al .gitignore)

NODE_ENV=development
PORT=3000

# Usuario de mínimo privilegio creado en el script 01
DATABASE_URL=postgresql://api_agendamiento:CAMBIA_ESTA_CLAVE@localhost:5432/agendamiento_crm

# Generar con:  node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=reemplazar_por_un_secreto_aleatorio_de_al_menos_32_caracteres
JWT_ISSUER=agendamiento-crm
JWT_AUDIENCE=agendamiento-crm-web
ACCESS_TOKEN_TTL=15m

REFRESH_TTL_DAYS=7
REFRESH_COOKIE_NAME=rt

# Origen del frontend (obligatorio para que funcionen las cookies con credentials)
CORS_ORIGIN=http://localhost:5173

# Política de bloqueo por fuerza bruta
MAX_INTENTOS_FALLIDOS=5
BLOQUEO_MINUTOS=15
